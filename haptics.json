   "wave": "hit_club"
  },
  {
   "match": "^snd:(a8|38)$",
   "when": {
    "weapon": "^202$|^2(03|0[a-f]|[1-9a-f][0-9a-f])$"
   },
   "wave": "swing_weapon"
  },
  {
   "match": "^ram:p\\d_grab:\\w+>01$",
   "wave": "grab"
  },
  {
   "match": "^snd:(a8|38)$",
   "wave": "swing"
  },
  {
   "match": "^snd:(39|3a)$",
   "wave": "hit"
  }
 ],
